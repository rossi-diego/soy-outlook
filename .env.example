# All optional. Nothing here is secret: every source is public and needs no key.

# Where bronze/silver/gold files and the premium seed live (default: ./data)
# SOY_DATA_DIR=./data
# Where the site JSON is written (default: ./web/public/data)
# SOY_WEB_DATA_DIR=./web/public/data
# WASDE history (default: latest release of rossi-diego/wasde-monthly-report)
# SOY_WASDE_URL=https://github.com/rossi-diego/wasde-monthly-report/releases/latest/download/wasde_full.parquet
# Use a local copy of wasde_full.parquet instead of downloading it
# SOY_WASDE_PARQUET=
# 1 = use cached bronze files only (no network)
# SOY_OFFLINE=0
# DEBUG | INFO | WARNING
# SOY_LOG_LEVEL=INFO
