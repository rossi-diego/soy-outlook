# All optional. Nothing here is secret: no source needs a key.

# Where bronze/silver/gold files live (default: ./data)
# SOY_DATA_DIR=./data
# Where the site JSON is written (default: ./web/public/data)
# SOY_WEB_DATA_DIR=./web/public/data
# WASDE history: releases of rossi-diego/usda-reports-dashboard. A run downloads the tag pinned in
# data/wasde.lock.json and checks its sha256; `soyforecast run --update-pin` moves the pin.
# SOY_WASDE_RELEASES_URL=https://github.com/rossi-diego/usda-reports-dashboard/releases
# SOY_WASDE_LOCK=./data/wasde.lock.json
# Use a local copy of wasde_full.parquet instead of downloading it
# SOY_WASDE_PARQUET=
# 1 = use cached bronze files only (no network; same as --offline). Fails (exit 3) if a cache is missing
# SOY_OFFLINE=0
# run_manifest.json lineage where there is no git checkout or repository root (set in the Docker
# image; GIT_SHA is the compose build argument that fills SOY_GIT_SHA)
# SOY_GIT_SHA=
# SOY_UV_LOCK=./uv.lock
# GIT_SHA=
# docker compose only: the user the unprivileged pipeline container runs as (Linux: id -u / id -g)
# SOY_UID=1000
# SOY_GID=1000
# DEBUG | INFO | WARNING
# SOY_LOG_LEVEL=INFO
# Public URL of the site, used for canonical URLs, the sitemap and social cards (web/, build time)
# NEXT_PUBLIC_SITE_URL=https://soy-outlook.vercel.app

# GitHub Actions only (a repository secret, never a local env var): a fine-grained token that lets the
# bot PR from refresh.yml trigger ci.yml and auto-merge. See docs/REFRESH.md.
# REFRESH_TOKEN=
