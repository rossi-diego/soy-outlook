{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ContractInfo": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[FHKNQUX]\\d{2}$",
          "type": "string"
        },
        "delivery_month": {
          "pattern": "^\\d{4}-\\d{2}$",
          "type": "string"
        },
        "first_notice": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        "last_trade": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        }
      },
      "required": [
        "code",
        "delivery_month",
        "first_notice",
        "last_trade"
      ],
      "title": "ContractInfo",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "nominal": {
          "$ref": "#/$defs/Nominal"
        },
        "validation": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoverageSplit"
            },
            {
              "type": "null"
            }
          ]
        },
        "holdout": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoverageSplit"
            },
            {
              "type": "null"
            }
          ]
        },
        "warn80": {
          "description": "Validation hit rate more than coverage_warn_pp below 80%.",
          "type": "boolean"
        },
        "warn95": {
          "description": "Validation hit rate more than coverage_warn_pp below 95%.",
          "type": "boolean"
        }
      },
      "required": [
        "nominal",
        "validation",
        "holdout",
        "warn80",
        "warn95"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "CoverageSplit": {
      "additionalProperties": false,
      "properties": {
        "years": {
          "type": "string"
        },
        "n": {
          "type": "integer"
        },
        "cover80": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "cover95": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "calibration_n_eff": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "ci80": {
          "description": "Moving-block bootstrap 95% CI of the 80% hit rate.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          ],
          "type": "array"
        },
        "ci95": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          ],
          "type": "array"
        },
        "n_eff80": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Approximate number of independent outcomes."
        },
        "n_eff95": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "years",
        "n",
        "cover80",
        "cover95",
        "calibration_n_eff",
        "ci80",
        "ci95",
        "n_eff80",
        "n_eff95"
      ],
      "title": "CoverageSplit",
      "type": "object"
    },
    "Horizon": {
      "additionalProperties": false,
      "properties": {
        "h": {
          "type": "integer"
        },
        "model": {
          "enum": [
            "rw",
            "drift",
            "arima",
            "ridge"
          ],
          "type": "string"
        },
        "target_date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        "mean_logret": {
          "type": "number"
        },
        "calibration_n": {
          "type": "integer"
        },
        "calibration_n_eff": {
          "type": "number"
        },
        "tail_obs_95": {
          "type": "number"
        },
        "contract": {
          "$ref": "#/$defs/HorizonContract"
        },
        "q025": {
          "type": "number"
        },
        "q100": {
          "type": "number"
        },
        "q500": {
          "type": "number"
        },
        "q900": {
          "type": "number"
        },
        "q975": {
          "type": "number"
        },
        "central": {
          "type": "number"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "premium_reference": {
          "$ref": "#/$defs/PremiumReference"
        }
      },
      "required": [
        "h",
        "model",
        "target_date",
        "mean_logret",
        "calibration_n",
        "calibration_n_eff",
        "tail_obs_95",
        "contract",
        "q025",
        "q100",
        "q500",
        "q900",
        "q975",
        "central",
        "coverage",
        "premium_reference"
      ],
      "title": "Horizon",
      "type": "object"
    },
    "HorizonContract": {
      "additionalProperties": false,
      "description": "The hedge contract for a horizon (P10); prices stay the continuous front month.",
      "properties": {
        "front_at_origin": {
          "description": "Contract ZS=F quotes at the origin close.",
          "pattern": "^[FHKNQUX]\\d{2}$",
          "type": "string"
        },
        "front_at_target": {
          "description": "Contract ZS=F will quote on the target date.",
          "pattern": "^[FHKNQUX]\\d{2}$",
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/ContractInfo",
          "description": "Hedge contract: the first whose first notice day is after the target date."
        },
        "crosses_roll": {
          "description": "The continuous front month rolls (at a last trading day) inside the window.",
          "type": "boolean"
        },
        "crosses_crop_roll": {
          "type": "boolean"
        },
        "series": {
          "type": "string"
        }
      },
      "required": [
        "front_at_origin",
        "front_at_target",
        "reference",
        "crosses_roll",
        "crosses_crop_roll",
        "series"
      ],
      "title": "HorizonContract",
      "type": "object"
    },
    "Nominal": {
      "additionalProperties": false,
      "properties": {
        "80": {
          "type": "number"
        },
        "95": {
          "type": "number"
        }
      },
      "required": [
        "80",
        "95"
      ],
      "title": "Nominal",
      "type": "object"
    },
    "PremiumNowDefault": {
      "additionalProperties": false,
      "description": "The one premium used for the headline and every horizon until the user enters a quote.",
      "properties": {
        "month": {
          "maximum": 12,
          "minimum": 1,
          "type": "integer"
        },
        "median": {
          "type": "number"
        },
        "p10": {
          "type": "number"
        },
        "p90": {
          "type": "number"
        },
        "years": {
          "description": "e.g. \"2015-2024\", derived from the data.",
          "type": "string"
        },
        "n_years": {
          "type": "integer"
        },
        "basis": {
          "type": "string"
        },
        "source_last": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        "stale": {
          "type": "boolean"
        },
        "illustrative": {
          "type": "boolean"
        }
      },
      "required": [
        "month",
        "median",
        "p10",
        "p90",
        "years",
        "n_years",
        "basis",
        "source_last",
        "stale",
        "illustrative"
      ],
      "title": "PremiumNowDefault",
      "type": "object"
    },
    "PremiumReference": {
      "additionalProperties": false,
      "description": "Reference text only (\"historical median, not validated\"); never used as the default.",
      "properties": {
        "month": {
          "maximum": 12,
          "minimum": 1,
          "type": "integer"
        },
        "median": {
          "type": "number"
        },
        "p10": {
          "type": "number"
        },
        "p90": {
          "type": "number"
        },
        "years": {
          "description": "e.g. \"2015-2024\", derived from the data.",
          "type": "string"
        },
        "n_years": {
          "type": "integer"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "month",
        "median",
        "p10",
        "p90",
        "years",
        "n_years",
        "note"
      ],
      "title": "PremiumReference",
      "type": "object"
    },
    "PricePoint": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        "c_bu": {
          "type": "number"
        }
      },
      "required": [
        "date",
        "c_bu"
      ],
      "title": "PricePoint",
      "type": "object"
    },
    "ReturnDistribution": {
      "additionalProperties": false,
      "properties": {
        "n": {
          "type": "integer"
        },
        "first": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        "last_start": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        "quantiles": {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        },
        "bin_step": {
          "type": "number"
        },
        "bin_edges": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "counts": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "n",
        "first",
        "last_start",
        "quantiles",
        "bin_step",
        "bin_edges",
        "counts"
      ],
      "title": "ReturnDistribution",
      "type": "object"
    },
    "Stress": {
      "additionalProperties": false,
      "description": "Historical stress replay (P19): illustrative scenarios, not probabilities.",
      "properties": {
        "label": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        },
        "p0_c_bu": {
          "type": "number"
        },
        "fx": {
          "type": "number"
        },
        "horizons": {
          "items": {
            "$ref": "#/$defs/StressHorizon"
          },
          "type": "array"
        }
      },
      "required": [
        "label",
        "rule",
        "basis",
        "p0_c_bu",
        "fx",
        "horizons"
      ],
      "title": "Stress",
      "type": "object"
    },
    "StressEpisode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^\\d{4}-\\d{2}$",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "start": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        "end": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        "logret": {
          "type": "number"
        },
        "pct": {
          "type": "number"
        },
        "percentile": {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        "c_bu": {
          "type": "number"
        },
        "usd_t": {
          "description": "CBOT price in USD/t, no premium.",
          "type": "number"
        },
        "cbot_brl_sack": {
          "description": "CBOT price only (no premium) in R$ per 60 kg sack at today's PTAX.",
          "type": "number"
        }
      },
      "required": [
        "id",
        "name",
        "rationale",
        "start",
        "end",
        "logret",
        "pct",
        "percentile",
        "c_bu",
        "usd_t",
        "cbot_brl_sack"
      ],
      "title": "StressEpisode",
      "type": "object"
    },
    "StressHorizon": {
      "additionalProperties": false,
      "properties": {
        "h": {
          "type": "integer"
        },
        "episodes": {
          "items": {
            "$ref": "#/$defs/StressEpisode"
          },
          "type": "array"
        },
        "distribution": {
          "$ref": "#/$defs/ReturnDistribution"
        }
      },
      "required": [
        "h",
        "episodes",
        "distribution"
      ],
      "title": "StressHorizon",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "as_of_close": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
    },
    "last": {
      "$ref": "#/$defs/PricePoint"
    },
    "horizons": {
      "items": {
        "$ref": "#/$defs/Horizon"
      },
      "type": "array"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/PricePoint"
      },
      "minItems": 1,
      "type": "array"
    },
    "premium_last": {
      "$ref": "#/$defs/PricePoint"
    },
    "stress": {
      "$ref": "#/$defs/Stress"
    },
    "premium_now_default": {
      "$ref": "#/$defs/PremiumNowDefault"
    }
  },
  "required": [
    "as_of_close",
    "last",
    "horizons",
    "history",
    "premium_last",
    "stress",
    "premium_now_default"
  ],
  "title": "Outlook",
  "type": "object"
}
