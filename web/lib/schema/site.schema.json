  "$defs": {
    "ArchiveEntry": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Archive file name; a WASDE-day re-publish has its own."
        },
        "as_of_close": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        "latest_wasde": {
          "pattern": "^\\d{4}-\\d{2}$",
          "type": "string"
        },
        "p0_c_bu": {
          "type": "number"
        },
        "horizons": {
          "items": {
            "$ref": "#/$defs/ArchivedHorizon"
          },
          "type": "array"
        }
      },
      "required": [
        "file",
        "as_of_close",
        "latest_wasde",
        "p0_c_bu",
        "horizons"
      ],
      "title": "ArchiveEntry",
      "type": "object"
    },
    "ArchiveIndex": {
      "additionalProperties": false,
      "description": "web/public/data/archive/index.json: every published outlook, scored once targets pass.",
      "properties": {
        "archive_schema_version": {
          "const": 1,
          "type": "integer"
        },
        "prices_through": {
          "type": "string"
        },
        "n_outlooks": {
          "type": "integer"
        },
        "n_resolved": {
          "type": "integer"
        },
        "inside80": {
          "type": "integer"
        },
        "inside95": {
          "type": "integer"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/ArchiveEntry"
          },
          "type": "array"
        }
      },
      "required": [
        "archive_schema_version",
        "prices_through",
        "n_outlooks",
        "n_resolved",
        "inside80",
        "inside95",
        "entries"
      ],
      "title": "ArchiveIndex",
      "type": "object"
    },
    "ArchivedHorizon": {
      "additionalProperties": false,
      "properties": {
        "h": {
          "type": "integer"
        },
        "model": {
          "enum": [
            "rw",
            "drift",
